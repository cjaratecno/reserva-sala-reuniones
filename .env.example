# =============================================================
# Copiar este archivo como .env y completar los valores.
# La configuración de Microsoft 365 (tenant, client id, secreto)
# NO va aquí: se ingresa en la web como administrador → Configuración.
# =============================================================

# --- Aplicación ---
# Puerto publicado en el host por docker compose
APP_PORT=3000
# URL pública con la que los usuarios abren la app. La URI de redirección que se
# registra en Azure es BASE_URL + /auth/callback (se muestra en Configuración).
BASE_URL=http://localhost:3000
# Cadena larga y aleatoria. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar-por-un-valor-aleatorio-largo
# Clave para cifrar el secreto de Microsoft 365 en la base de datos (si se omite se usa SESSION_SECRET).
# Si se cambia, habrá que volver a ingresar el secreto en Configuración.
CLAVE_CIFRADO=
# true si la app queda detrás de un proxy inverso (Nginx, IIS, Traefik, Azure App Gateway...)
TRUST_PROXY=false

# --- PostgreSQL (contenedor "db") ---
POSTGRES_USER=reservas
# Evite los caracteres $ y comillas (Docker Compose los interpreta)
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=reserva_salas
# true si se usa un PostgreSQL externo que exige SSL
DATABASE_SSL=false
